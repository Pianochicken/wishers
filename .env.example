# WISHERS Environment Variables Template
# Copy this file to .env at the root of the project and fill in your keys!

# -----------------------------------------------------------------------------
# 1. World ID / AgentKit (https://developer.world.org)
# -----------------------------------------------------------------------------
VITE_WORLD_APP_ID=app_your_world_app_id
WORLD_RP_ID=rp_your_world_rp_id
RP_SIGNING_KEY=sk_staging_dummy_key

# -----------------------------------------------------------------------------
# 2. Uniswap Trading API (https://hub.uniswap.org)
# -----------------------------------------------------------------------------
UNISWAP_API_KEY=your_uniswap_api_key_here
WISHERS_TREASURY_ADDRESS=0xYourWalletAddressHere  # Receives 0.1% fee

# -----------------------------------------------------------------------------
# 3. The Graph Studio (https://thegraph.com/studio)
# -----------------------------------------------------------------------------
THE_GRAPH_API_KEY=your_the_graph_api_key_here

# -----------------------------------------------------------------------------
# 4. LLM Provider Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxx
GROQ_API_KEY=gsk_xxxxx  # Free fallback option
