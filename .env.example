# WISHERS Environment Variables Template
# Copy this file to .env at the root of the project and fill in your keys!

# -----------------------------------------------------------------------------
# 1. World ID (https://developer.world.org)
# -----------------------------------------------------------------------------
VITE_WORLD_APP_ID=app_your_world_app_id
WORLD_RP_ID=rp_your_world_rp_id
RP_SIGNING_KEY=your_rp_signing_key

# -----------------------------------------------------------------------------
# 2. Uniswap Trading API (https://hub.uniswap.org)
# -----------------------------------------------------------------------------
UNISWAP_API_KEY=your_uniswap_api_key

# -----------------------------------------------------------------------------
# 3. The Graph Studio (https://thegraph.com/studio)
# -----------------------------------------------------------------------------
THE_GRAPH_API_KEY=your_the_graph_api_key
THE_GRAPH_SUBGRAPH_ID=your_the_graph_subgraph_id  # Base Uniswap V3 Subgraph

# -----------------------------------------------------------------------------
# 4. LLM Provider Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_openai_api_key
GROQ_API_KEY=gsk_your_groq_api_key  # Free fallback option
